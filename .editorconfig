# EditorConfig for Skylotus Unity Core.
#
# This describes the style already in use under Assets/Scripts/ (see e.g.
# ServiceLocator.cs, Bootstrapper.cs) rather than a preferred style being imposed on it.
# Do not "fix" existing files to satisfy a rule added here without a separate, reviewed
# change — see CLAUDE.md.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Every existing .cs file in this repo is LF-only despite core.autocrlf being enabled for
# some contributors -- match the committed content, not the local git config.
[*.cs]
end_of_line = lf
indent_size = 4

# --- Braces: Allman (own line), everywhere ----------------------------------
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true
csharp_indent_braces = false

# --- Namespaces: block-scoped, not file-scoped ------------------------------
# `namespace Skylotus { ... }`, never `namespace Skylotus;`. Every file in this codebase
# uses the block form; keep it that way for consistency across the ~90 existing files.
csharp_style_namespace_declarations = block_scoped:warning

# --- Field naming: _camelCase for private / internal fields -----------------
dotnet_naming_rule.private_fields_underscore_camel_case.severity = warning
dotnet_naming_rule.private_fields_underscore_camel_case.symbols = private_or_internal_fields
dotnet_naming_rule.private_fields_underscore_camel_case.style = underscore_camel_case

dotnet_naming_symbols.private_or_internal_fields.applicable_kinds = field
dotnet_naming_symbols.private_or_internal_fields.applicable_accessibilities = private, internal, private_protected

dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# [SerializeField] private fields follow the same rule (e.g. `_screenContainer`), including
# on MonoBehaviours where Unity's own samples often use bare camelCase — this codebase does
# not follow that convention.
dotnet_naming_rule.serialized_fields_underscore_camel_case.severity = warning
dotnet_naming_rule.serialized_fields_underscore_camel_case.symbols = serialized_fields
dotnet_naming_rule.serialized_fields_underscore_camel_case.style = underscore_camel_case

dotnet_naming_symbols.serialized_fields.applicable_kinds = field
dotnet_naming_symbols.serialized_fields.applicable_accessibilities = *
dotnet_naming_symbols.serialized_fields.required_modifiers =

# --- Everything else public gets an XML doc comment --------------------------
# Not enforceable as a compiler warning without <GenerateDocumentationFile> in every
# asmdef (out of this file's ownership boundary, see CORE_FIXES.md WP-13). Documented here
# as policy, enforced by review: every public type and member gets a /// summary, matching
# every existing file under Assets/Scripts/Core/Runtime/.
dotnet_style_require_accessibility_modifiers = always:warning

# --- var usage: match existing code (var when the type is obvious) ----------
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# --- Expression-bodied members: existing code prefers full bodies -----------
csharp_style_expression_bodied_methods = false:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

# --- using directives -------------------------------------------------------
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

[*.{yml,yaml}]
indent_size = 2
end_of_line = lf

[*.json]
indent_size = 2

[*.{asmdef,asmref}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Unity scene/prefab/asset/mixer YAML is generated by the Editor via -executeMethod and is
# never hand-edited (see CORE_FIXES.md rule 4) -- do not reformat it, and editors should not
# try to apply C#/text rules to it.
[*.{unity,prefab,asset,mixer,mat,controller,anim,physicsMaterial2D}]
insert_final_newline = false
trim_trailing_whitespace = false
